# ==============================================================
# Single-stage Dockerfile (Traditional Build - Chưa tối ưu)
# Image: hw-backend:single
# Base image: node:18 (Debian-based distribution, dung lượng lớn ~1.08GB)
# ==============================================================
FROM node:18

WORKDIR /app

# Copy khai báo phụ thuộc
COPY package*.json ./

# Cài đặt toàn bộ dependencies (kèm npm cache và các công cụ dev)
RUN npm install

# Copy toàn bộ mã nguồn ứng dụng
COPY . .

# Mở cổng 3000
EXPOSE 3000

# Khởi chạy ứng dụng trực tiếp bằng quyền root
CMD ["node", "server.js"]
